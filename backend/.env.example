# ─────────────────────────────────────────────────────
#  BrandMeld Backend — Environment Variable Reference
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────
# Supabase project URL
# Get from: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (server-side only — never expose to browser)
# Get from: Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase JWT Secret — used to verify user tokens in auth middleware
# Get from: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Google Gemini API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Allowed frontend origins (comma-separated, no trailing slashes)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── V2: Token Encryption ───────────────────────────────
# Used to encrypt OAuth access tokens at rest in connected_accounts table.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── V2: LinkedIn OAuth ─────────────────────────────────
# Create an app at: https://www.linkedin.com/developers/apps
# Required scopes: openid, profile, email, w_member_social
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# The HTTPS URL LinkedIn will redirect to after OAuth consent.
# For local dev: use your staging Cloud Run URL.
# For prod: use your production Cloud Run URL.
# Must match exactly what you register in the LinkedIn Developer Portal.
# Example: https://brandmeld-staging-abc123-uc.a.run.app/v1/auth/linkedin/callback
LINKEDIN_REDIRECT_URI=https://your-cloud-run-url.a.run.app/v1/auth/linkedin/callback

# ── V2: Frontend URL ───────────────────────────────────
# Used to redirect users back to the frontend after OAuth callback.
# Local dev: http://localhost:5173
# Production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:5173

# ── V2: Mailgun (Phase 3 — optional) ──────────────────
# Get from: https://mailgun.com → API Keys
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM_EMAIL=prompts@mg.yourdomain.com

# ── V2: Segment Analytics (Phase 3 — optional) ────────
SEGMENT_WRITE_KEY=your-segment-write-key
